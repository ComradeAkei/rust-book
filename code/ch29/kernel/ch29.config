# Глава 29: обычное ядро. Накладывается на tinyconfig — самую маленькую
# конфигурацию, с которой ядро вообще собирается, — скриптом build.sh.

# Основа: 64 бита, несколько процессоров, журнал с отметками времени.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
# Без ACPI QEMU сообщает ядру только о первом процессоре.
CONFIG_ACPI=y

# Консоль на последовательном порту — это stdout QEMU с -nographic.
# Без VT и INPUT ядро не ищет клавиатуру и мышь PS/2 и не шумит о них.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# CONFIG_VT is not set
# CONFIG_INPUT is not set

# initramfs с init на Rust, /proc, /sys и /dev без udev.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_FUTEX=y

# Модули и Rust.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_RUST=y
CONFIG_SAMPLES=y
CONFIG_SAMPLES_RUST=y
CONFIG_SAMPLE_RUST_MINIMAL=m
CONFIG_SAMPLE_RUST_MISC_DEVICE=m
# Образец для задачи 29.D1.
CONFIG_SAMPLE_KOBJECT=m

# Шина PCI и MSI для устройства edu (раздел 29.8).
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Отладка: debugfs, ftrace (задача 29.D2), DWARF и скрипты gdb (29.9),
# имена кодов ошибок вместо чисел, раскрутка стека ORC и стек задачи в
# vmalloc со сторожевой страницей.
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_GDB_SCRIPTS=y
CONFIG_SYMBOLIC_ERRNAME=y
CONFIG_UNWINDER_ORC=y
CONFIG_VMAP_STACK=y
