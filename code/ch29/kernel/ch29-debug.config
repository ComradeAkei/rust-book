# Глава 29: отладочное ядро — ch29.config и сверху этот фрагмент.
CONFIG_DEBUG_KERNEL=y
# SLUB_TINY в tinyconfig включён и исключает отладку кучи.
# CONFIG_SLUB_TINY is not set
CONFIG_SLUB_DEBUG=y
# KASAN: выход за границы и доступ после освобождения. KASAN_VMALLOC
# нужен, чтобы стек задачи остался в vmalloc (VMAP_STACK).
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_VMALLOC=y
# Утечки памяти.
CONFIG_DEBUG_KMEMLEAK=y
# lockdep: порядок блокировок, блокировка при возврате в пространство
# пользователя, копии мьютексов.
CONFIG_PROVE_LOCKING=y
# Сон в атомарном контексте.
CONFIG_DEBUG_ATOMIC_SLEEP=y
