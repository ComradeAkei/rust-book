<?xml version="1.0" encoding="utf-8"?>
<!-- Подмножество описания LM3S6965 для главы 27: системное управление,
     порты GPIO, UART, таймеры и АЦП. UART0 и UART1 — те же, что в главе 24.
     Регистры, смещения, поля и значения после сброса — по техническому
     описанию LM3S6965. Формат — CMSIS-SVD 1.3. По этому файлу svd2rust
     строит крейт code/ch27-pac (раздел 27.3). -->
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Texas Instruments</vendor>
  <name>LM3S6965</name>
  <version>1.0</version>
  <description>Stellaris LM3S6965, подмножество: SYSCTL, GPIOA–GPIOG, UART0, UART1, TIMER0–TIMER3, ADC0</description>
  <!-- ANCHOR: cpu -->
  <cpu>
    <name>CM3</name>
    <revision>r2p0</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>3</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <!-- ANCHOR_END: cpu -->
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>SYSCTL</name>
      <description>Системное управление: тактирование и сброс</description>
      <groupName>SYSCTL</groupName>
      <baseAddress>0x400FE000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>RCC</name>
          <description>Настройка тактирования</description>
          <addressOffset>0x060</addressOffset>
          <resetValue>0x078E3AD1</resetValue>
          <fields>
            <field>
              <name>MOSCDIS</name>
              <description>Выключить главный генератор</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IOSCDIS</name>
              <description>Выключить внутренний генератор</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>OSCSRC</name>
              <description>Источник тактов</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MAIN</name>
                  <description>Главный генератор</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INTERNAL</name>
                  <description>Внутренний генератор 12 МГц</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INTERNAL_DIV4</name>
                  <description>Внутренний генератор, делённый на 4</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>XTAL</name>
              <description>Частота кварца</description>
              <bitOffset>6</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>BYPASS</name>
              <description>Обойти PLL</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PWRDN</name>
              <description>Выключить PLL</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>USESYSDIV</name>
              <description>Делить системную частоту на SYSDIV + 1</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SYSDIV</name>
              <description>Делитель системной частоты</description>
              <bitOffset>23</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>ACG</name>
              <description>Автоматическое управление тактами в режимах сна</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RCGC0</name>
          <description>Такты периферии в рабочем режиме, группа 0</description>
          <addressOffset>0x100</addressOffset>
          <resetValue>0x00000040</resetValue>
          <fields>
            <field>
              <name>WDT</name>
              <description>Сторожевой таймер</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADC</name>
              <description>АЦП</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RCGC1</name>
          <description>Такты периферии в рабочем режиме, группа 1</description>
          <addressOffset>0x104</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>3</dim>
              <dimIncrement>1</dimIncrement>
              <name>UART%s</name>
              <description>UART0–UART2</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <name>TIMER%s</name>
              <description>Таймеры 0–3</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RCGC2</name>
          <description>Такты периферии в рабочем режиме, группа 2: порты GPIO</description>
          <addressOffset>0x108</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>7</dim>
              <dimIncrement>1</dimIncrement>
              <name>GPIO%s</name>
              <description>Порты A–G (бит 0 — порт A)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>GPIOA</name>
      <description>Порт ввода-вывода общего назначения (PL061)</description>
      <groupName>GPIO</groupName>
      <baseAddress>0x40004000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>GPIOA</name>
        <value>0</value>
      </interrupt>
      <registers>
        <register>
          <dim>256</dim>
          <dimIncrement>4</dimIncrement>
          <name>DATA[%s]</name>
          <description>Данные. Биты 2–9 адреса — маска: читаются и пишутся только выводы, чьи биты маски равны 1</description>
          <addressOffset>0x000</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Уровень вывода</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DIR</name>
          <description>Направление: 1 — выход</description>
          <addressOffset>0x400</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Вывод — выход</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IS</name>
          <description>Чувствительность прерывания: 1 — по уровню, 0 — по фронту</description>
          <addressOffset>0x404</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>По уровню</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IBE</name>
          <description>Прерывание по обоим фронтам</description>
          <addressOffset>0x408</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Оба фронта</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IEV</name>
          <description>Событие прерывания: 1 — нарастающий фронт или высокий уровень</description>
          <addressOffset>0x40C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Нарастающий фронт или высокий уровень</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IM</name>
          <description>Маска прерываний: 1 — прерывание разрешено</description>
          <addressOffset>0x410</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Прерывание разрешено</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RIS</name>
          <description>Необработанные запросы прерываний</description>
          <addressOffset>0x414</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Запрос есть</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>MIS</name>
          <description>Запросы прерываний после маски</description>
          <addressOffset>0x418</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Запрос есть</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ICR</name>
          <description>Сброс запросов прерываний по фронту: 1 сбрасывает бит</description>
          <addressOffset>0x41C</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Сбросить запрос</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AFSEL</name>
          <description>Альтернативная функция: 1 — выводом управляет периферия</description>
          <addressOffset>0x420</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Альтернативная функция</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ODR</name>
          <description>Открытый сток</description>
          <addressOffset>0x50C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Открытый сток</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PUR</name>
          <description>Подтяжка к питанию</description>
          <addressOffset>0x510</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Подтяжка к питанию</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PDR</name>
          <description>Подтяжка к земле</description>
          <addressOffset>0x514</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Подтяжка к земле</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DEN</name>
          <description>Цифровой режим: 1 — вывод работает как цифровой</description>
          <addressOffset>0x51C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>1</dimIncrement>
              <name>P%s</name>
              <description>Цифровой режим</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="GPIOA">
      <name>GPIOB</name>
      <baseAddress>0x40005000</baseAddress>
      <interrupt>
        <name>GPIOB</name>
        <value>1</value>
      </interrupt>
    </peripheral>
    <peripheral derivedFrom="GPIOA">
      <name>GPIOC</name>
      <baseAddress>0x40006000</baseAddress>
      <interrupt>
        <name>GPIOC</name>
        <value>2</value>
      </interrupt>
    </peripheral>
    <peripheral derivedFrom="GPIOA">
      <name>GPIOD</name>
      <baseAddress>0x40007000</baseAddress>
      <interrupt>
        <name>GPIOD</name>
        <value>3</value>
      </interrupt>
    </peripheral>
    <peripheral derivedFrom="GPIOA">
      <name>GPIOE</name>
      <baseAddress>0x40024000</baseAddress>
      <interrupt>
        <name>GPIOE</name>
        <value>4</value>
      </interrupt>
    </peripheral>
    <peripheral derivedFrom="GPIOA">
      <name>GPIOF</name>
      <baseAddress>0x40025000</baseAddress>
      <interrupt>
        <name>GPIOF</name>
        <value>30</value>
      </interrupt>
    </peripheral>
    <peripheral derivedFrom="GPIOA">
      <name>GPIOG</name>
      <baseAddress>0x40026000</baseAddress>
      <interrupt>
        <name>GPIOG</name>
        <value>31</value>
      </interrupt>
    </peripheral>
    <!-- ANCHOR: uart0 -->
    <peripheral>
      <name>UART0</name>
      <description>Универсальный асинхронный приёмопередатчик (PL011)</description>
      <groupName>UART</groupName>
      <baseAddress>0x4000C000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>UART0</name>
        <value>5</value>
      </interrupt>
      <registers>
        <register>
          <name>DR</name>
          <description>Данные: запись — в FIFO передатчика, чтение — из FIFO приёмника с флагами ошибок</description>
          <addressOffset>0x000</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Байт данных</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>255</maximum>
                </range>
              </writeConstraint>
            </field>
            <field>
              <name>FE</name>
              <description>Ошибка кадра</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <!-- ANCHOR_END: uart0 -->
            <field>
              <name>PE</name>
              <description>Ошибка чётности</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BE</name>
              <description>Разрыв линии</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OE</name>
              <description>Переполнение приёмника</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RSR</name>
          <description>Состояние приёма; запись сбрасывает ошибки (UARTECR)</description>
          <addressOffset>0x004</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>FE</name>
              <description>Ошибка кадра</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PE</name>
              <description>Ошибка чётности</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>BE</name>
              <description>Разрыв линии</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>OE</name>
              <description>Переполнение приёмника</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FR</name>
          <description>Флаги</description>
          <addressOffset>0x018</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000090</resetValue>
          <fields>
            <field>
              <name>BUSY</name>
              <description>Передатчик занят</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFE</name>
              <description>FIFO приёмника пуст</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF</name>
              <description>FIFO передатчика полон</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFF</name>
              <description>FIFO приёмника полон</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFE</name>
              <description>FIFO передатчика пуст</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ILPR</name>
          <description>Делитель IrDA для режима низкого потребления</description>
          <addressOffset>0x020</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ILPDVSR</name>
              <description>Делитель</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IBRD</name>
          <description>Целая часть делителя скорости</description>
          <addressOffset>0x024</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DIVINT</name>
              <description>Целая часть</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>65535</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>FBRD</name>
          <description>Дробная часть делителя скорости</description>
          <addressOffset>0x028</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DIVFRAC</name>
              <description>Дробная часть, 1/64</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>63</maximum>
                </range>
              </writeConstraint>
            </field>
          </fields>
        </register>
        <register>
          <name>LCRH</name>
          <description>Формат кадра</description>
          <addressOffset>0x02C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>BRK</name>
              <description>Послать разрыв</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PEN</name>
              <description>Чётность включена</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EPS</name>
              <description>Чётность — чётная</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STP2</name>
              <description>Два стоповых бита</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FEN</name>
              <description>FIFO включены</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WLEN</name>
              <description>Длина слова: 0 — 5 бит … 3 — 8 бит</description>
              <bitOffset>5</bitOffset>
              <bitWidth>2</bitWidth>
              <writeConstraint>
                <range>
                  <minimum>0</minimum>
                  <maximum>3</maximum>
                </range>
              </writeConstraint>
            </field>
