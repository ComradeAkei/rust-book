      <description>Аналого-цифровой преобразователь, 10 бит</description>
      <groupName>ADC</groupName>
      <baseAddress>0x40038000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>ADC0SS0</name>
        <value>14</value>
      </interrupt>
      <interrupt>
        <name>ADC0SS1</name>
        <value>15</value>
      </interrupt>
      <interrupt>
        <name>ADC0SS2</name>
        <value>16</value>
      </interrupt>
      <interrupt>
        <name>ADC0SS3</name>
        <value>17</value>
      </interrupt>
      <registers>
        <register>
          <name>ACTSS</name>
          <description>Включённые последовательности выборки</description>
          <addressOffset>0x000</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <name>SS%s</name>
              <description>Последовательность включена</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RIS</name>
          <description>Необработанные запросы прерываний</description>
          <addressOffset>0x004</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <name>SS%s</name>
              <description>Последовательность закончила выборку</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IM</name>
          <description>Маска прерываний</description>
          <addressOffset>0x008</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <name>SS%s</name>
              <description>Прерывание разрешено</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ISC</name>
          <description>Запросы после маски; запись 1 сбрасывает запрос</description>
          <addressOffset>0x00C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <name>SS%s</name>
              <description>Запрос есть; 1 — сбросить</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>OSTAT</name>
          <description>Переполнение FIFO</description>
          <addressOffset>0x010</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <name>SS%s</name>
              <description>FIFO переполнено; 1 — сбросить</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>EMUX</name>
          <description>Источник запуска каждой последовательности</description>
          <addressOffset>0x014</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>4</dim>
              <dimIncrement>4</dimIncrement>
              <name>EM%s</name>
              <description>Запуск последовательности</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PROCESSOR</name>
                  <description>Программный запуск через PSSI</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COMP0</name>
                  <description>Аналоговый компаратор 0</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COMP1</name>
                  <description>Аналоговый компаратор 1</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTERNAL</name>
                  <description>Внешний сигнал GPIO PB4</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER</name>
                  <description>Таймер с битом TnOTE</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM0</name>
                  <description>ШИМ 0</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM1</name>
                  <description>ШИМ 1</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM2</name>
                  <description>ШИМ 2</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALWAYS</name>
                  <description>Непрерывно</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>USTAT</name>
          <description>Опустошение FIFO</description>
          <addressOffset>0x018</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <name>SS%s</name>
              <description>FIFO опустошено; 1 — сбросить</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PSSI</name>
          <description>Программный запуск последовательностей</description>
          <addressOffset>0x028</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <name>SS%s</name>
              <description>Запустить последовательность</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SSMUX3</name>
          <description>Последовательность 3: номер входа</description>
          <addressOffset>0x0A0</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MUX0</name>
              <description>Вход АЦП</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SSCTL3</name>
          <description>Последовательность 3: управление выборкой</description>
          <addressOffset>0x0A4</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>D0</name>
              <description>Дифференциальный вход</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>END0</name>
              <description>Последняя выборка последовательности</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IE0</name>
              <description>Прерывание после выборки</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TS0</name>
              <description>Датчик температуры вместо входа</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SSFIFO3</name>
          <description>Последовательность 3: результат из FIFO</description>
          <addressOffset>0x0A8</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Результат преобразования</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SSFSTAT3</name>
          <description>Последовательность 3: состояние FIFO</description>
          <addressOffset>0x0AC</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000100</resetValue>
          <fields>
            <field>
              <name>TPTR</name>
              <description>Хвост</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>HPTR</name>
              <description>Голова</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>EMPTY</name>
              <description>Пусто</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FULL</name>
              <description>Полно</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
